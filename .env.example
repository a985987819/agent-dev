# ===== 模型配置(OpenAI 兼容协议,任选一家即可)=====
# 用法:复制本文件为 .env 并填入真实 Key。.env 已被 .gitignore 排除,不会提交到 GitHub。

# --- DeepSeek(示例)---
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-xxx
AI_MODEL=deepseek-chat

# --- 阿里云百炼(通义千问)---
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_API_KEY=sk-xxx
# AI_MODEL=qwen-plus

# --- 智谱 GLM ---
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_API_KEY=xxx
# AI_MODEL=glm-4.6

# --- Moonshot Kimi ---
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_API_KEY=sk-xxx
# AI_MODEL=kimi-k2-0905-preview

# --- OpenAI 官方 ---
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxx
# AI_MODEL=gpt-4o

# ===== 浏览器 Agent 安全配置 =====
# 域名白名单(逗号分隔):agent 只允许访问这些注册域名及其子域。
# 这是"只操作公开网页"的第一道防线 —— 宁可窄,不可宽。
ALLOWED_DOMAINS=example.com,iana.org,quotes.toscrape.com,books.toscrape.com

# 是否无头模式运行浏览器。调试时改为 false 可以肉眼看到 agent 的每一步操作。
HEADLESS=true
